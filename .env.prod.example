# Copiar a ~/analizador-frontend/.env.production en la VM. Solo configuracion publica.
FRONTEND_IMAGE=ghcr.io/telettubies/telettubiesplus-frontend
FRONTEND_TAG=latest
BACKEND_NETWORK=analizador_interna
VITE_API_BASE_URL=https://api.ejemplo.com/api
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# Usar exclusivamente la clave publishable o JWT con rol anon.
VITE_SUPABASE_ANON_KEY=
VITE_USE_MOCKS=false
