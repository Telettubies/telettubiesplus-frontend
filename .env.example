# Plantilla de Variables de Entorno (S-06: Jamás incluir SUPABASE_SERVICE_ROLE_KEY ni claves privadas)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=reemplazar_con_anon_key_publica

# Interruptor global (true = todo usa mockups; false = usa FastAPI real)
VITE_USE_MOCKS=true

# Interruptores granulares por feature
VITE_MOCK_AUTH=true
VITE_MOCK_MIEMBROS=true
VITE_MOCK_CONOCIMIENTO=true
VITE_MOCK_PANEL=true
VITE_MOCK_CARGA=true
VITE_MOCK_MATRIZ=true
VITE_MOCK_VISOR=true
VITE_MOCK_REVISION=true
VITE_MOCK_CHAT=true

